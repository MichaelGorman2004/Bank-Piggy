# Local empty household. Demo mode binds only to loopback.
APP_MODE=demo
LISTEN_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql://bankpiggy:bankpiggy@127.0.0.1:5432/bankpiggy?sslmode=disable
WEB_DIST_DIR=../web/dist

# Private mode uses one or two invited Google identities and your PostgreSQL database.
# Keep bootstrap invitation order stable. Partner links do not need an env change.
# APP_MODE=private
# APP_BASE_URL=https://your-domain.example
# GOOGLE_CLIENT_ID=replace-with-client-id
# GOOGLE_CLIENT_SECRET=replace-with-client-secret
# HOUSEHOLD_INVITES=first@example.com,second@example.com

# Use a separate disposable database for integration tests.
# TEST_DATABASE_URL=postgresql://bankpiggy:bankpiggy@127.0.0.1:5432/bankpiggy_test?sslmode=disable

# Optional read-only Plaid. Keep disabled until server security settings are ready.
# No PLAID variable belongs in Vite or Docker build arguments.
# PLAID_ENABLED=true
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=replace-with-client-id
# PLAID_SECRET=replace-with-sandbox-secret
# PLAID_ACTIVE_KEY_ID=key-1
# PLAID_TOKEN_KEYS=key-1:replace-with-base64-of-32-random-bytes
# Production also needs verified actual Trial eligibility and remaining team capacity.
# PLAID_PRODUCTION_APPROVED=true
# PLAID_LIFETIME_ITEM_LIMIT=approved-remaining-budget
