# Local sample household. Demo mode binds only to loopback.
APP_MODE=demo
LISTEN_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://bankpiggy:bankpiggy@127.0.0.1:5432/bankpiggy?sslmode=disable

# Private mode uses two invited Google identities and your PostgreSQL database.
# APP_MODE=private
# APP_BASE_URL=https://your-domain.example
# GOOGLE_CLIENT_ID=replace-with-client-id
# GOOGLE_CLIENT_SECRET=replace-with-client-secret
# HOUSEHOLD_INVITES=first@example.com,second@example.com

# Use a separate disposable database for integration tests.
# TEST_DATABASE_URL=postgresql://bankpiggy:bankpiggy@127.0.0.1:5432/bankpiggy_test?sslmode=disable
