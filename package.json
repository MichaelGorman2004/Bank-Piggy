{
  "name": "bank-piggy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @bank-piggy/web",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "build": "npm run build --workspace @bank-piggy/web && npm run build:api",
    "build:api": "cd apps/api && go build -o ../../dist/bank-piggy ./cmd/server",
    "typecheck": "npm run typecheck --workspace @bank-piggy/web",
    "lint": "npm run lint:web && npm run lint:scripts && npm run lint:api",
    "vet:api": "cd apps/api && go vet ./...",
    "test": "npm run test:web && npm run test:api",
    "format": "prettier --write . && cd apps/api && gofmt -w .",
    "format:check": "prettier --check . && node scripts/check-go-format.mjs",
    "unused:check": "knip",
    "contracts:generate": "python3 packages/contracts/generate.py",
    "check": "npm run contracts:check && npm run providers:check && npm run format:check && npm run size:check && npm run lint && npm run typecheck && npm run unused:check && npm test && npm run build",
    "lint:web": "oxlint --type-aware apps/web/src apps/web/vite.config.ts && eslint apps/web/src apps/web/vite.config.ts --max-warnings=0",
    "lint:scripts": "eslint scripts eslint.config.mjs --max-warnings=0",
    "lint:api": "cd apps/api && golangci-lint run --config ../../.golangci.yml",
    "size:check": "node scripts/check-source-size.mjs",
    "contracts:check": "python3 packages/contracts/generate.py --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "audit": "npm run audit:npm && npm run audit:go",
    "test:api": "cd apps/api && go test -race -count=1 ./...",
    "test:web": "node --test",
    "providers:generate": "node scripts/generate-provider-icons.mjs",
    "providers:check": "node scripts/generate-provider-icons.mjs --check",
    "audit:npm": "npm audit --audit-level=moderate",
    "audit:go": "cd apps/api && go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./..."
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "knip": "^6.45.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "~7.0.2006",
    "prettier": "^3.9.10",
    "simple-icons": "^16.37.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.7"
  }
}
