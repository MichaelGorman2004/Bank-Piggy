{
  "openapi": "3.1.0",
  "info": {
    "title": "Bank Piggy API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/session": {
      "post": {
        "operationId": "createDemoSession",
        "description": "Loopback demo mode only. Opens the saved local household, which starts empty. Requires same-origin request.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session ended"
          }
        }
      }
    },
    "/api/household": {
      "get": {
        "operationId": "getHousehold",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseholdResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "Planning month; defaults to the current UTC month. Year 0001 through 9998. The yearly summary projects this month and the following eleven months.",
            "schema": {
              "type": "string",
              "pattern": "^(?!0000|9999)[0-9]{4}-(0[1-9]|1[0-2])$",
              "description": "Planning calendar month in YYYY-MM format, year 0001 through 9998."
            }
          }
        ]
      },
      "put": {
        "operationId": "updateHousehold",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "Planning month; defaults to the current UTC month. Year 0001 through 9998. The yearly summary projects this month and the following eleven months.",
            "schema": {
              "type": "string",
              "pattern": "^(?!0000|9999)[0-9]{4}-(0[1-9]|1[0-2])$",
              "description": "Planning calendar month in YYYY-MM format, year 0001 through 9998."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Household"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseholdResponse"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict; reload before saving"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "operationId": "googleSignIn",
        "responses": {
          "302": {
            "description": "Google sign-in redirect"
          }
        },
        "description": "Normal sign-in clears pending invitation context. Explicit join=1 requires a valid prepared invitation and binds its hash to the one-use sign-in attempt.",
        "parameters": [
          {
            "name": "join",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["1"]
            },
            "description": "Join the prepared household invitation. Omit for normal sign-in."
          }
        ]
      }
    },
    "/auth/google/callback": {
      "get": {
        "operationId": "googleCallback",
        "responses": {
          "302": {
            "description": "Signed in; redirect home"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Database available"
          }
        }
      }
    },
    "/api/household/invitation": {
      "get": {
        "operationId": "getInvitationStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createInvitation",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationCreated"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeInvitation",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Pending invitation revoked"
          }
        }
      }
    },
    "/api/household/invitation/prepare": {
      "post": {
        "operationId": "prepareInvitation",
        "description": "Exact-origin request. Validates link possession and prepares a short-lived Google sign-in attempt. Invitation is consumed only after verified sign-in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationPrepareRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreview"
                }
              }
            }
          }
        }
      }
    },
    "/api/todos": {
      "get": {
        "operationId": "getTodos",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CalendarDate"
            },
            "description": "The client local calendar date, or an explicitly selected As-of date."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoList"
                }
              }
            }
          }
        }
      }
    },
    "/api/todos/{id}": {
      "put": {
        "operationId": "updateTodo",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Split": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "customFirstShareBps"],
        "properties": {
          "method": {
            "type": "string",
            "enum": ["equal", "salary", "custom"]
          },
          "customFirstShareBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "First member share in basis points (10000 = 100%). Ignored for equal and salary splits."
          }
        }
      },
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "annualBaseSalaryCents",
          "monthlyTakeHomeCents",
          "debtCents",
          "payFrequency",
          "accounts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["member-1", "member-2"]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "annualBaseSalaryCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "monthlyTakeHomeCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000,
            "description": "Monthly cash received after taxes, payroll retirement contributions, and other automatic payroll investments. Separate payroll estimates do not reduce this amount again."
          },
          "debtCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "payFrequency": {
            "type": "string",
            "enum": ["weekly", "biweekly", "semimonthly", "monthly", "irregular"]
          },
          "accounts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/AccountBalance"
            },
            "description": "Stable account IDs are unique within this member. Each savings or investment group total must not exceed 100000000000 cents."
          },
          "payroll": {
            "$ref": "#/components/schemas/Payroll"
          },
          "paySchedule": {
            "$ref": "#/components/schemas/PaySchedule"
          }
        }
      },
      "Expense": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "monthlyAmountCents",
          "ownerId",
          "paidByMemberId",
          "split"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "monthlyAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "ownerId": {
            "type": "string",
            "enum": ["shared", "member-1", "member-2"]
          },
          "paidByMemberId": {
            "type": "string",
            "enum": ["", "member-1", "member-2"]
          },
          "split": {
            "$ref": "#/components/schemas/Split"
          },
          "kind": {
            "type": "string",
            "enum": ["subscription", "bill", "loan"]
          },
          "providerId": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "startMonth": {
            "type": "string",
            "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Calendar month in YYYY-MM format, year 0001 through 9999."
          },
          "endMonth": {
            "type": "string",
            "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Last active calendar month, inclusive. Omit for an ongoing payment."
          },
          "paymentMode": {
            "type": "string",
            "enum": ["automatic", "manual"],
            "description": "Absent defaults to automatic for subscriptions and manual for other costs. Only manual costs create payment reminders."
          },
          "dueDay": {
            "$ref": "#/components/schemas/DayOfMonth"
          }
        }
      },
      "Goal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "monthlyAmountCents", "ownerId"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "monthlyAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "ownerId": {
            "type": "string",
            "enum": ["shared", "member-1", "member-2"]
          },
          "trip": {
            "$ref": "#/components/schemas/TripBudget"
          },
          "purchase": {
            "$ref": "#/components/schemas/PurchaseTarget"
          },
          "savingsTarget": {
            "$ref": "#/components/schemas/SavingsTarget"
          },
          "contributionYear": {
            "$ref": "#/components/schemas/ContributionYear"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["trip", "purchase"]
            },
            {
              "required": ["trip", "savingsTarget"]
            },
            {
              "required": ["purchase", "savingsTarget"]
            }
          ]
        },
        "description": "A monthly allocation with optional ordinary savings, trip, or purchase progress. These progress details are mutually exclusive. A contributionYear identifies a personal Roth IRA annual goal and requires an ordinary savingsTarget. Its annual target is entered by the user; it is not an eligibility or contribution-limit calculation."
      },
      "Household": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "members", "expenses", "goals", "defaultSplitMethod"],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "expenses": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Expense"
            }
          },
          "goals": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/Goal"
            }
          },
          "defaultSplitMethod": {
            "type": "string",
            "enum": ["equal", "salary", "custom"]
          }
        },
        "description": "One member-1 profile, with an optional member-2 profile added explicitly. Existing profiles keep their fixed order and identities. All amounts are monthly planned cents. Revision is an optimistic concurrency token."
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monthlyTakeHomeCents",
          "monthlyExpensesCents",
          "monthlyGoalsCents",
          "monthlyAvailableCents",
          "monthlyRemainingCents",
          "savingsCents",
          "investmentsCents",
          "debtCents"
        ],
        "properties": {
          "monthlyTakeHomeCents": {
            "type": "integer"
          },
          "monthlyExpensesCents": {
            "type": "integer"
          },
          "monthlyGoalsCents": {
            "type": "integer"
          },
          "monthlyAvailableCents": {
            "type": "integer"
          },
          "monthlyRemainingCents": {
            "type": "integer"
          },
          "savingsCents": {
            "type": "integer"
          },
          "investmentsCents": {
            "type": "integer"
          },
          "debtCents": {
            "type": "integer"
          }
        }
      },
      "ExpenseShare": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expenseId", "firstMemberCents", "secondMemberCents"],
        "properties": {
          "expenseId": {
            "type": "string"
          },
          "firstMemberCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200000000000
          },
          "secondMemberCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200000000000
          }
        }
      },
      "BudgetSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["household", "members", "expenseShares", "goalShares"],
        "properties": {
          "household": {
            "$ref": "#/components/schemas/Summary"
          },
          "members": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Summary"
            }
          },
          "expenseShares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseShare"
            }
          },
          "goalShares": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalShare"
            }
          }
        }
      },
      "HouseholdResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "household",
          "summary",
          "planningMonth",
          "yearlySummary",
          "tripProjections",
          "purchaseProjections",
          "payrollSummaries"
        ],
        "properties": {
          "household": {
            "$ref": "#/components/schemas/Household"
          },
          "summary": {
            "$ref": "#/components/schemas/BudgetSummary",
            "description": "Selected planning-month totals and exact member shares."
          },
          "planningMonth": {
            "type": "string",
            "pattern": "^(?!0000|9999)[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Planning calendar month in YYYY-MM format, year 0001 through 9998."
          },
          "yearlySummary": {
            "$ref": "#/components/schemas/BudgetSummary",
            "description": "Exact sum of twelve monthly projections from planningMonth, including payment schedule boundaries. Monthly-named flow fields contain the twelve-month totals here; savings, investments and debt remain unscaled balance snapshots."
          },
          "tripProjections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalProjection"
            }
          },
          "purchaseProjections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalProjection"
            }
          },
          "payrollSummaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayrollSummary"
            },
            "maxItems": 2
          }
        }
      },
      "Viewer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authenticated", "mode", "googleConfigured", "viewer", "csrfToken"],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": ["demo", "private"]
          },
          "googleConfigured": {
            "type": "boolean"
          },
          "viewer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Viewer"
              },
              {
                "type": "null"
              }
            ]
          },
          "csrfToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "code"],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "GoalShare": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goalId", "firstMemberCents", "secondMemberCents"],
        "properties": {
          "goalId": {
            "type": "string"
          },
          "firstMemberCents": {
            "type": "integer",
            "maximum": 1200000000000
          },
          "secondMemberCents": {
            "type": "integer",
            "maximum": 1200000000000
          }
        }
      },
      "TripCost": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "amountCents"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["flights", "lodging", "food", "transport", "activities", "other"]
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        }
      },
      "TripBudget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["savedAmountCents", "targetMonth", "costs"],
        "properties": {
          "savedAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "targetMonth": {
            "type": "string",
            "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Calendar month in YYYY-MM format, year 0001 through 9999."
          },
          "costs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/TripCost"
            }
          }
        },
        "description": "Manual vacation target derived from distinct category costs. Saved amount is a progress input, not another account balance or monthly allocation."
      },
      "PurchaseTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetAmountCents", "savedAmountCents", "targetMonth"],
        "properties": {
          "targetAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "savedAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "targetMonth": {
            "type": "string",
            "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Calendar month in YYYY-MM format, year 0001 through 9999."
          }
        },
        "description": "Manual savings target for a purchase. Saved amount records progress, not another account balance. Only the goal monthly contribution is deducted from the budget."
      },
      "GoalProjection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "targetAmountCents",
          "remainingAmountCents",
          "monthsRemaining",
          "suggestedMonthlyCents",
          "status"
        ],
        "properties": {
          "goalId": {
            "type": "string"
          },
          "targetAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "remainingAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "monthsRemaining": {
            "type": "integer",
            "minimum": 0
          },
          "suggestedMonthlyCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "status": {
            "type": "string",
            "enum": ["saving", "funded", "overdue"]
          }
        },
        "description": "Whole monthly saving periods include the planning month and deadline month. Suggested amount rounds up to the next cent. Past deadlines have zero periods and zero suggestion; the remaining amount stays visible."
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "traditional_401k",
          "roth_401k",
          "traditional_ira",
          "roth_ira",
          "brokerage",
          "high_yield_savings",
          "savings",
          "other_investment"
        ]
      },
      "AccountBalance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "balanceCents"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "balanceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "description": "A manually entered account snapshot owned by one member. Savings and high-yield savings count as savings; the other account types count as investments."
      },
      "SavingsTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetAmountCents", "savedAmountCents"],
        "properties": {
          "targetAmountCents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000000
          },
          "savedAmountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "description": "Optional manual progress for an ordinary goal. Saved amount can exceed the target. Progress does not change monthly allocations or account balances."
      },
      "CalendarDate": {
        "type": "string",
        "pattern": "^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
        "description": "A valid calendar date from 2000 through 2100, without a time zone."
      },
      "DayOfMonth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31
      },
      "ContributionYear": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 2100
      },
      "MatchTier": {
        "type": "object",
        "additionalProperties": false,
        "required": ["upToContributionBps", "matchRateBps"],
        "properties": {
          "upToContributionBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "matchRateBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          }
        },
        "description": "Cumulative employee contribution threshold as a percent of salary, and employer match rate on the slice since the prior threshold. 100 basis points is 1 percent."
      },
      "Payroll": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "traditional401kBps",
          "roth401kBps",
          "matchMethod",
          "matchTiers",
          "employerMonthlyCents"
        ],
        "properties": {
          "traditional401kBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "roth401kBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "matchMethod": {
            "type": "string",
            "enum": ["none", "tiers", "fixed"]
          },
          "matchTiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchTier"
            },
            "maxItems": 5
          },
          "employerMonthlyCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "description": "Optional payroll estimates. Employee rates together cannot exceed 100 percent. Tiers must have increasing thresholds. None and fixed methods have no tiers; only fixed uses employerMonthlyCents. Never deduct these figures from entered take-home pay again."
      },
      "PaySchedule": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorDate", "semiMonthlyDays"],
        "properties": {
          "anchorDate": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "semiMonthlyDays": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOfMonth"
            },
            "maxItems": 2
          },
          "monthEnd": {
            "type": "boolean",
            "description": "Monthly pay only. True means the last calendar day of each month, and the entered anchor must itself be a month-end date. False or absent keeps the anchor day number."
          }
        },
        "description": "An actual payday anchors weekly, biweekly, or monthly cadence. Semimonthly requires two ordered distinct days that never clamp to the same date. Other frequencies require an empty days array. Irregular pay cannot have an inferred schedule."
      },
      "PayrollSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberId",
          "traditional401kMonthlyCents",
          "roth401kMonthlyCents",
          "employerMonthlyCents"
        ],
        "properties": {
          "memberId": {
            "type": "string",
            "enum": ["member-1", "member-2"]
          },
          "traditional401kMonthlyCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "roth401kMonthlyCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "employerMonthlyCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "description": "Monthly estimates from entered salary and contribution rules. These do not change spendable cash or account balances."
      },
      "PayPeriod": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memberId", "memberName", "startDate", "nextPayDate", "dueDate"],
        "properties": {
          "memberId": {
            "type": "string",
            "enum": ["member-1", "member-2"]
          },
          "memberName": {
            "type": "string"
          },
          "startDate": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "nextPayDate": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "dueDate": {
            "$ref": "#/components/schemas/CalendarDate"
          }
        }
      },
      "TodoItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "memberId",
          "sourceId",
          "kind",
          "name",
          "amountCents",
          "periodStart",
          "dueDate",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "memberId": {
            "type": "string",
            "enum": ["member-1", "member-2"]
          },
          "sourceId": {
            "type": "string",
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": ["goal", "expense"]
          },
          "name": {
            "type": "string",
            "maxLength": 140
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "periodStart": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "dueDate": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "description": "One manual acknowledgment for a generated pay-period task. Checking it does not transfer money or update a goal balance."
      },
      "TodoList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "planRevision", "periods", "tasks", "unscheduledExpenseIds"],
        "properties": {
          "date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "planRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayPeriod"
            },
            "maxItems": 2
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoItem"
            },
            "maxItems": 460
          },
          "unscheduledExpenseIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Active manual bills without a due day. They need a due day before payment reminders can be scheduled."
          }
        }
      },
      "TodoUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "planRevision", "expectedCompleted", "completed"],
        "properties": {
          "date": {
            "$ref": "#/components/schemas/CalendarDate"
          },
          "planRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expectedCompleted": {
            "type": "boolean"
          },
          "completed": {
            "type": "boolean"
          }
        },
        "description": "Checks the current plan revision and expected completion state before an idempotent checkbox update."
      },
      "InvitationStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canInvite", "linked", "pending"],
        "properties": {
          "canInvite": {
            "type": "boolean"
          },
          "linked": {
            "type": "boolean"
          },
          "pending": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string"
          },
          "memberName": {
            "type": "string"
          }
        }
      },
      "InvitationCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "expiresAt"],
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "description": "The invitation secret is returned only once. Only its hash is stored."
      },
      "InvitationPrepareRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "InvitationPreview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["householdName", "memberName", "expiresAt"],
        "properties": {
          "householdName": {
            "type": "string"
          },
          "memberName": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "description": "A limited invitation preview without financial data. Preparing does not consume the invitation or create membership."
      }
    }
  }
}
